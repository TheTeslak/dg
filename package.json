{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm check:i18n && tsx ./scripts/search-index.ts && cross-env NODE_OPTIONS=--localstorage-file=.localstorage NODE_ENV=production vite-ssg build && tsx ./scripts/copy-fonts.ts && tsx ./scripts/rss.ts && tsx scripts/redirects.ts && cp _dist_redirects dist/_redirects && pnpm check:seo",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "dev": "NODE_OPTIONS='--localstorage-file=.localstorage' vite --port 1111 --open",
    "preview": "vite preview",
    "redirects": "tsx scripts/redirects.ts",
    "lint:md": "tsx scripts/lint-md.ts",
    "lint": "eslint .",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:node",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "compress": "tsx scripts/img-compress-staged.ts",
    "photos": "tsx scripts/photos-manage.ts",
    "process-audio": "tsx scripts/process-audio.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fluent/bundle": "catalog:",
    "@unhead/vue": "catalog:frontend",
    "@unocss/reset": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "dayjs": "catalog:frontend",
    "floating-vue": "catalog:frontend",
    "fluent-vue": "catalog:",
    "matter-attractors": "catalog:frontend",
    "matter-js": "catalog:frontend",
    "minisearch": "catalog:",
    "nprogress": "catalog:frontend",
    "pinia": "catalog:frontend",
    "pixi.js": "catalog:frontend",
    "shiki": "catalog:frontend",
    "simplex-noise": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@antfu/utils": "catalog:frontend",
    "@iconify/json": "catalog:dev",
    "@octokit/core": "catalog:dev",
    "@octokit/rest": "catalog:dev",
    "@shikijs/markdown-it": "catalog:build",
    "@shikijs/transformers": "catalog:build",
    "@shikijs/twoslash": "catalog:build",
    "@types/fs-extra": "catalog:types",
    "@types/markdown-it": "catalog:types",
    "@types/markdown-it-link-attributes": "catalog:types",
    "@types/node": "catalog:types",
    "@types/nprogress": "catalog:types",
    "@types/prompts": "catalog:types",
    "@unocss/preset-web-fonts": "catalog:build",
    "@unpic/placeholder": "catalog:frontend",
    "@vitejs/plugin-vue": "catalog:build",
    "ansis": "catalog:dev",
    "blurhash": "catalog:dev",
    "cross-env": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "exifreader": "catalog:dev",
    "fast-glob": "catalog:dev",
    "feed": "catalog:dev",
    "fs-extra": "catalog:dev",
    "gray-matter": "catalog:build",
    "image-size": "catalog:",
    "lint-staged": "catalog:dev",
    "markdown-it": "catalog:build",
    "markdown-it-anchor": "catalog:build",
    "markdown-it-github-alerts": "catalog:build",
    "markdown-it-link-attributes": "catalog:build",
    "markdown-it-magic-link": "catalog:build",
    "markdown-it-table-of-contents": "catalog:build",
    "music-metadata": "catalog:dev",
    "pathe": "catalog:dev",
    "pnpm": "catalog:dev",
    "prompts": "catalog:dev",
    "rimraf": "catalog:dev",
    "sharp": "catalog:dev",
    "simple-git": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-icons": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "unplugin-vue-markdown": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build",
    "vite-plugin-optimize-exclude": "catalog:build",
    "vite-ssg": "catalog:build",
    "vite-svg-loader": "catalog:build",
    "vue-tsc": "catalog:dev"
  },
  "resolutions": {
    "vite": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
