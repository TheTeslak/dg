---
interface Props {
  url: string
  author?: string
  handle?: string
  avatar?: string
  date?: string
}
const { url, author, handle, avatar, date } = Astro.props
---
<a class="tweet-card" href={url} target="_blank" rel="noopener noreferrer">
  <div class="tweet-head">
    {avatar && <img class="tweet-avatar" src={avatar} alt="" loading="lazy" decoding="async" />}
    <div class="tweet-meta">
      {author && <div class="tweet-author">{author}</div>}
      {handle && <div class="tweet-handle">@{handle}</div>}
    </div>
    <span class="tweet-icon i-simple-icons-x" aria-hidden="true"></span>
  </div>
  <div class="tweet-body"><slot /></div>
  {date && <time class="tweet-date" datetime={date}>{date}</time>}
</a>

<style>
  .tweet-card {
    display: block;
    margin: 1.5em 0;
    padding: 1rem 1.15rem;
    border: 1px solid rgba(125, 125, 125, 0.25);
    border-radius: 0.65rem;
    text-decoration: none !important;
    color: inherit;
    background: rgba(125, 125, 125, 0.04);
    transition: background-color 200ms ease, border-color 200ms ease;
  }
  .tweet-card:hover {
    background: rgba(125, 125, 125, 0.07);
    border-color: rgba(125, 125, 125, 0.4);
  }
  .tweet-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .tweet-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .tweet-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .tweet-author {
    font-weight: 600;
    font-size: 1rem;
  }
  .tweet-handle {
    font-size: 0.85rem;
    opacity: 0.55;
  }
  .tweet-icon {
    margin-left: auto;
    font-size: 1.1rem;
    opacity: 0.5;
  }
  .tweet-body {
    font-size: 1rem;
    line-height: 1.55;
  }
  .tweet-date {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    opacity: 0.45;
  }
</style>
