---
interface Props {
  title?: string
}
const { title = 'Spoiler' } = Astro.props
---
<details class="spoiler">
  <summary class="spoiler-summary">
    <span class="spoiler-arrow i-ri-arrow-right-s-line" aria-hidden="true"></span>
    <span>{title}</span>
  </summary>
  <div class="spoiler-content">
    <slot />
  </div>
</details>

<style>
  .spoiler {
    background: rgba(125, 125, 125, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 0.5rem;
    margin: 1.25em 0;
    overflow: hidden;
    transition: border-radius 0.25s ease;
  }
  .spoiler-summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.7em 1em;
    cursor: pointer;
    font-size: inherit;
    font-weight: 500;
    color: var(--fg-deep);
    user-select: none;
    list-style: none;
    transition: background 0.2s ease;
  }
  .spoiler-summary::-webkit-details-marker { display: none; }
  .spoiler-summary:hover {
    background: rgba(125, 125, 125, 0.08);
  }
  .spoiler-arrow {
    font-size: 1.15em;
    opacity: 0.5;
    flex-shrink: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .spoiler[open] > .spoiler-summary .spoiler-arrow {
    transform: rotate(90deg);
    opacity: 0.8;
  }
  .spoiler-content {
    padding: 0 1em 0.8em;
    font-size: inherit;
    color: var(--fg);
    overflow: hidden;
  }
  .spoiler-content > :global(*:first-child) { margin-top: 0; }
  .spoiler-content > :global(*:last-child) { margin-bottom: 0; }
</style>

<script>
  // Smooth height animation (matches the legacy WAAPI animation behavior).
  function animateSpoiler(details: HTMLDetailsElement) {
    if (details.dataset.bound === '1') return
    details.dataset.bound = '1'
    const summary = details.querySelector<HTMLElement>('summary')
    const body = details.querySelector<HTMLElement>('.spoiler-content')
    if (!summary || !body) return
    let running: Animation | null = null
    summary.addEventListener('click', (e) => {
      e.preventDefault()
      if (running) { running.cancel(); running = null }
      const open = details.hasAttribute('open')
      if (!open) {
        details.setAttribute('open', '')
        const h = body.scrollHeight
        running = body.animate(
          [
            { height: '0px', opacity: 0 },
            { height: `${h}px`, opacity: 1 },
          ],
          { duration: 280, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        )
        running.onfinish = () => { running = null }
      } else {
        const h = body.scrollHeight
        running = body.animate(
          [
            { height: `${h}px`, opacity: 1 },
            { height: '0px', opacity: 0 },
          ],
          { duration: 220, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
        )
        running.onfinish = () => {
          details.removeAttribute('open')
          running!.cancel()
          running = null
        }
      }
    })
  }
  function init() {
    document.querySelectorAll<HTMLDetailsElement>('details.spoiler').forEach(animateSpoiler)
  }
  init()
  document.addEventListener('astro:page-load', init)
</script>
