---
interface Heading { depth: number; slug: string; text: string }
interface Props {
  headings: Heading[]
  title: string
  duration?: string
  alwaysOn?: boolean
  labels: { link: string; copied: string }
}
const { headings, title, duration, alwaysOn = false, labels } = Astro.props
---

<div class:list={['scroll-toc', alwaysOn && 'is-always-on']} data-scroll-toc data-labels={JSON.stringify(labels)}>
  <div class="scroll-toc-anchor table-of-contents-anchor"><span class="i-ri-menu-2-fill" aria-hidden="true"></span></div>
  <div class="scroll-toc-panel">
    <header class="scroll-toc-title"><strong>{title}</strong>{duration && <span>{duration}</span>}</header>
    <div class="scroll-toc-track" aria-hidden="true"><span data-toc-progress></span></div>
    <nav class="scroll-toc-list" aria-label={title}>
      {headings.map((heading, index) => (
        <button type="button" class:list={['scroll-toc-item', heading.depth >= 3 && 'is-h3']} data-toc-id={heading.slug} data-toc-index={index}>
          <span class="scroll-toc-dot"></span><span class="scroll-toc-label">{heading.text}</span>
        </button>
      ))}
    </nav>
  </div>
</div>

<div class="mobile-action-bar" data-mobile-toc-bar>
  <button type="button" class="mobile-action-btn" data-mobile-toc-open aria-label={title}><span class="i-ri-menu-2-fill" aria-hidden="true"></span></button>
  <button type="button" class="mobile-action-btn" data-mobile-copy aria-label={labels.link}><span class="i-ri-links-line" data-mobile-copy-icon aria-hidden="true"></span><span data-mobile-copy-text hidden>{labels.copied}</span></button>
</div>
<div class="mobile-toc-backdrop" data-mobile-toc-backdrop hidden></div>
<aside class="mobile-toc-sheet" data-mobile-toc-sheet hidden aria-label={title}>
  <header><div><strong>{title}</strong>{duration && <small>{duration}</small>}</div><button type="button" data-mobile-toc-close aria-label="Close"><span class="i-ri-close-line" aria-hidden="true"></span></button></header>
  <nav>
    {headings.map(heading => <button type="button" class:list={['mobile-toc-sheet-item', heading.depth >= 3 && 'is-h3']} data-toc-id={heading.slug}>{heading.text}</button>)}
  </nav>
</aside>

<script>
  import '~/scripts/scroll-progress-toc.ts'
</script>

<style is:global>
  .scroll-toc { position: fixed; inset: 5rem auto 2.5rem 1.1rem; z-index: 200; display: none; width: min(25rem, calc(50vw - 25rem)); min-width: 12rem; pointer-events: none; }
  .scroll-toc-anchor { position: absolute; top: 0; left: 0; pointer-events: none; transition: opacity 250ms ease, transform 250ms ease; }
  .scroll-toc-panel { height: 100%; padding: 0.25rem 0; opacity: 0; transform: translateX(-0.5rem); pointer-events: none; transition: opacity 280ms ease, transform 280ms cubic-bezier(.16,1,.3,1); }
  .scroll-toc:hover .scroll-toc-panel,
  .scroll-toc:focus-within .scroll-toc-panel,
  .scroll-toc.is-near .scroll-toc-panel,
  .scroll-toc.is-always-on .scroll-toc-panel { opacity: 1; transform: none; pointer-events: auto; }
  .scroll-toc:hover .scroll-toc-anchor,
  .scroll-toc:focus-within .scroll-toc-anchor,
  .scroll-toc.is-near .scroll-toc-anchor,
  .scroll-toc.is-always-on .scroll-toc-anchor { opacity: 0; transform: translateX(-0.4rem); }
  .scroll-toc-title { display: flex; flex-direction: column; padding: 0 0.75rem 0.75rem 1.35rem; line-height: 1.25; }
  .scroll-toc-title strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.85rem; opacity: 0.82; }
  .scroll-toc-title span { margin-top: 0.12rem; font-size: 0.73rem; opacity: 0.45; }
  .scroll-toc-list { position: relative; display: flex; flex-direction: column; max-height: calc(100% - 3rem); overflow: auto; scrollbar-width: none; }
  .scroll-toc-track { position: absolute; top: 3rem; bottom: 0.5rem; left: 0.45rem; width: 1px; background: #8883; overflow: hidden; }
  .scroll-toc-track span { display: block; width: 100%; height: 0; background: #777b; transition: height 180ms ease-out; }
  html.dark .scroll-toc-track span { background: #ccca; }
  .scroll-toc-item { display: grid; grid-template-columns: 0.9rem minmax(0, 1fr); align-items: center; gap: 0.45rem; width: 100%; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; padding: 0.28rem 0.75rem 0.28rem 0; opacity: 0.5; transition: opacity 200ms ease, transform 200ms ease; }
  .scroll-toc-item.is-h3 { padding-left: 0.55rem; font-size: 0.92em; }
  .scroll-toc-item:hover,
  .scroll-toc-item.is-active { opacity: 1; transform: translateX(0.15rem); }
  .scroll-toc-dot { width: 0.32rem; height: 0.32rem; justify-self: center; border-radius: 50%; background: currentColor; transition: transform 200ms ease; }
  .scroll-toc-item.is-active .scroll-toc-dot { transform: scale(1.6); }
  .scroll-toc-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.8rem; line-height: 1.3; }
  .mobile-action-bar { display: none; }
  .mobile-toc-backdrop,
  .mobile-toc-sheet { display: none; }
  @media (min-width: 1024px) { .scroll-toc { display: block; pointer-events: auto; } }
  @media (max-width: 1023px) {
    .mobile-action-bar { position: fixed; inset: auto 0 0; z-index: 300; display: flex; justify-content: space-between; padding: 0.5rem 1rem calc(0.5rem + env(safe-area-inset-bottom)); pointer-events: none; }
    .mobile-action-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-width: 2.75rem; height: 2.75rem; padding: 0 0.85rem; border: 0; border-radius: 999px; background: var(--c-bg); color: inherit; box-shadow: 0 3px 16px #0002; pointer-events: auto; cursor: pointer; transition: background 200ms ease, transform 200ms ease; }
    .mobile-action-btn:hover { background: #8882; transform: translateY(-1px); }
    .mobile-toc-backdrop { position: fixed; inset: 0; z-index: 400; display: block; background: #0006; opacity: 1; transition: opacity 300ms ease; }
    .mobile-toc-backdrop[hidden] { display: none; }
    .mobile-toc-sheet { position: fixed; inset: auto 0 0; z-index: 401; display: flex; flex-direction: column; max-height: 65vh; padding-bottom: env(safe-area-inset-bottom); border-radius: 1.25rem 1.25rem 0 0; background: color-mix(in srgb, var(--c-bg) 96%, transparent); box-shadow: 0 -8px 36px #0003; backdrop-filter: blur(20px); animation: toc-sheet-in 350ms cubic-bezier(.32,.72,0,1) both; }
    .mobile-toc-sheet[hidden] { display: none; }
    .mobile-toc-sheet header { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem 0.5rem; }
    .mobile-toc-sheet header > div { display: flex; flex-direction: column; min-width: 0; }
    .mobile-toc-sheet header strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mobile-toc-sheet header small { margin-top: 0.15rem; opacity: 0.5; }
    .mobile-toc-sheet header button { width: 2rem; height: 2rem; border: 0; border-radius: 50%; background: #8882; color: inherit; cursor: pointer; }
    .mobile-toc-sheet nav { overflow: auto; padding: 0.5rem 1rem 1rem; }
    .mobile-toc-sheet-item { display: block; width: 100%; border: 0; border-radius: 0.5rem; background: none; color: inherit; text-align: left; padding: 0.55rem 0.75rem; opacity: 0.58; cursor: pointer; transition: background 150ms ease, opacity 150ms ease; }
    .mobile-toc-sheet-item.is-h3 { padding-left: 1.75rem; font-size: 0.9em; }
    .mobile-toc-sheet-item:hover,
    .mobile-toc-sheet-item.is-active { background: #8882; opacity: 1; }
  }
  @keyframes toc-sheet-in { from { transform: translateY(100%); } }
  @media print { .scroll-toc, .mobile-action-bar, .mobile-toc-backdrop, .mobile-toc-sheet { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { .scroll-toc *, .mobile-action-bar *, .mobile-toc-sheet { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
</style>
