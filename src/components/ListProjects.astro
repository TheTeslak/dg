---
import { makeT, type SupportedLocale } from '~/utils/i18n'
import { resolveLocalizedText, type ProjectSection } from '~/data/projects'

interface Props {
  projects: ProjectSection[]
  locale: SupportedLocale
}
const { projects, locale } = Astro.props
const t = makeT(locale)

function slug(name: string) {
  return name.toLowerCase().replace(/[\s\\/]+/g, '-')
}
---
{projects.length === 0 ? (
  <div class="prose m-auto">
    <div class="py-2 op50 slide-enter">{t('projects-nothing-here')}</div>
  </div>
) : (
  <>
    <div class="prose m-auto">
      {projects.map((section, cidx) => {
        const title = resolveLocalizedText(section.title, locale)
        return (
          <div class="slide-enter" style={`--enter-stage: ${cidx + 1};`}>
            <div
              id={slug(title)}
              class="select-none relative h-18 mt-5 pointer-events-none slide-enter"
              style={`--enter-stage: ${cidx - 2}; --enter-step: 60ms;`}
            >
              <span class="text-5em color-transparent absolute left--1rem top-0rem font-bold leading-1em text-stroke-1.5 text-stroke-hex-aaa op-35 dark:op-20">{title}</span>
            </div>
            <div class="project-grid py-2">
              {section.projects.map(project => (
                <a
                  class="item block font-normal no-underline"
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={resolveLocalizedText(project.name, locale)}
                >
                  <div class="title text-xl leading-1.2em">{resolveLocalizedText(project.name, locale)}</div>
                  <div class="desc text-xl opacity-75 font-normal mt-1" set:html={resolveLocalizedText(project.desc, locale)} />
                </a>
              ))}
            </div>
          </div>
        )
      })}
    </div>
    <div>
      <div class="table-of-contents">
        <div class="table-of-contents-anchor">
          <div class="i-ri-menu-2-fill"></div>
        </div>
        <ul>
          {projects.map(section => (
            <li>
              <a href={`#${slug(resolveLocalizedText(section.title, locale))}`}>{resolveLocalizedText(section.title, locale)}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </>
)}

<style>
  .project-grid {
    display: flex;
    flex-direction: column;
  }
  .project-grid a.item {
    margin-bottom: 0.8rem;
    padding: 0.4rem 0;
  }
</style>
