---
import { makeT, type SupportedLocale } from '~/utils/i18n'

interface Props {
  locale: SupportedLocale
}
const { locale } = Astro.props
const closeLabel = makeT(locale)('lightbox-close')
---
<div
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label={closeLabel}
  tabindex="-1"
  data-lightbox
  hidden
>
  <div class="lightbox-bg" aria-hidden="true"></div>
  <img id="lightbox-img" alt="" />
  <div id="lightbox-caption" hidden></div>
  <button
    type="button"
    id="lightbox-close"
    class="lightbox-close"
    aria-label={closeLabel}
  >
    <span class="i-ri-close-line text-xl" aria-hidden="true"></span>
  </button>
</div>

<style>
  [data-lightbox] {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    background: rgba(0, 0, 0, 0.5);
    user-select: none;
    cursor: zoom-out;
  }
  [data-lightbox]:not([hidden]) {
    display: flex;
  }
  .lightbox-bg {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: -1;
  }
  #lightbox-img {
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    cursor: zoom-out;
  }
  #lightbox-caption {
    color: white;
    background: rgba(0, 0, 0, 0.55);
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    padding: 0.25rem 0.65rem;
    border-radius: 0.25rem;
    font-size: 0.95rem;
  }
  #lightbox-caption[hidden] {
    display: none;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 501;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: 0;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 200ms ease, background 200ms ease;
  }
  .lightbox-close:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.8);
  }
</style>

<script>
  type ImgEl = HTMLImageElement
  let activeImage: ImgEl | null = null
  let triggerElement: HTMLElement | null = null
  let cleanup: (() => void) | null = null

  function getGalleryImages(): ImgEl[] {
    return Array.from(
      document.querySelectorAll<ImgEl>(
        '.prose img:not(.no-preview), .photos img:not(.no-preview), [data-photo-index]',
      ),
    )
  }

  function applyFilterClasses(target: ImgEl, source: ImgEl) {
    const filters = source.className
      .split(/\s+/)
      .filter(c => c.includes('filter'))
      .join(' ')
    target.className = filters
  }

  function setCaption(img: ImgEl) {
    const caption = document.getElementById('lightbox-caption') as HTMLDivElement | null
    if (!caption) return
    const isGallery
      = img.dataset.photoIndex != null
      || !!img.closest('.photos')
    let text = ''
    if (isGallery) {
      text = img.alt || ''
      const figure = img.closest('figure')
      if (figure) {
        const figcaption = figure.querySelector('figcaption')
        if (!text && figcaption?.textContent)
          text = figcaption.textContent
      }
    }
    if (text) {
      caption.textContent = text
      caption.hidden = false
    } else {
      caption.textContent = ''
      caption.hidden = true
    }
  }

  function focusFirst(box: HTMLElement) {
    const close = box.querySelector<HTMLElement>('.lightbox-close')
    if (close) close.focus()
    else box.focus()
  }

  function openLightbox(img: ImgEl) {
    const box = document.getElementById('lightbox') as HTMLElement | null
    const lImg = document.getElementById('lightbox-img') as ImgEl | null
    if (!box || !lImg) return
    activeImage = img
    triggerElement = (document.activeElement as HTMLElement) || null
    lImg.src = img.currentSrc || img.src
    lImg.alt = img.alt || ''
    applyFilterClasses(lImg, img)
    setCaption(img)
    box.hidden = false
    document.body.style.overflow = 'hidden'
    focusFirst(box)
  }

  function closeLightbox() {
    const box = document.getElementById('lightbox') as HTMLElement | null
    if (!box) return
    box.hidden = true
    activeImage = null
    document.body.style.overflow = ''
    if (triggerElement && document.contains(triggerElement)) {
      triggerElement.focus()
      triggerElement = null
    }
  }

  function navigateBy(delta: number) {
    if (!activeImage) return
    const images = getGalleryImages()
    const idx = images.indexOf(activeImage)
    if (idx === -1) return
    const target = images[idx + delta]
    if (target) openLightbox(target)
  }

  function bindFocusTrap(box: HTMLElement, signal: AbortSignal) {
    box.addEventListener(
      'keydown',
      (e) => {
        if (e.key !== 'Tab') return
        const focusable = box.querySelectorAll<HTMLElement>(
          'button, [href], [tabindex]:not([tabindex="-1"])',
        )
        const first = focusable[0]
        const last = focusable[focusable.length - 1]
        if (!first) {
          e.preventDefault()
          return
        }
        if (e.shiftKey) {
          if (document.activeElement === first || document.activeElement === box) {
            e.preventDefault()
            last.focus()
          }
        } else if (document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      },
      { signal },
    )
  }

  function isInsidePreviewableArea(target: EventTarget | null): boolean {
    if (!(target instanceof HTMLElement)) return false
    return !!target.closest('.prose, .photos, [data-photo-index]')
  }

  function init() {
    if (cleanup) cleanup()
    const ctrl = new AbortController()
    const { signal } = ctrl

    document.addEventListener(
      'click',
      (e) => {
        const path = (e.composedPath ? e.composedPath() : []) as EventTarget[]
        const first = path[0]
        if (!(first instanceof HTMLImageElement)) return
        if (first.classList.contains('no-preview')) return
        if (
          path.some(
            el => el instanceof HTMLElement && (el.tagName === 'A' || el.tagName === 'BUTTON'),
          )
        ) return
        if (!isInsidePreviewableArea(first)) return
        openLightbox(first)
      },
      { signal, passive: true },
    )

    const closeBtn = document.getElementById('lightbox-close')
    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation()
        closeLightbox()
      }, { signal })
    }

    const box = document.getElementById('lightbox') as HTMLElement | null
    if (box) {
      box.addEventListener('click', closeLightbox, { signal })
      bindFocusTrap(box, signal)
    }

    document.addEventListener(
      'keydown',
      (e) => {
        if (box?.hidden) return
        if (e.key === 'Escape') {
          e.preventDefault()
          closeLightbox()
        } else if (e.key === 'ArrowRight') {
          e.preventDefault()
          navigateBy(1)
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault()
          navigateBy(-1)
        }
      },
      { signal },
    )

    cleanup = () => ctrl.abort()
  }

  init()
  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', () => {
    if (cleanup) cleanup()
    cleanup = null
  })
</script>
