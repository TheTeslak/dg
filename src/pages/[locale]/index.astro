---
import { render } from 'astro:content'
import Default from '~/layouts/Default.astro'
import HomeIntro from '~/components/HomeIntro.astro'
import { supportedLocales, type SupportedLocale } from '~/utils/i18n'
import { getStaticPage } from '~/utils/static-pages'

export async function getStaticPaths() {
  return supportedLocales.map(locale => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: SupportedLocale }
const entry = await getStaticPage(locale, 'home')
const { Content } = await render(entry)
const content = entry.data
---
<Default
  locale={locale}
  title={content.title}
  description={content.description}
  art={content.art}
>
  <HomeIntro
    display={content.display || content.title}
    avatarHref={`/${locale}/who-is-teslak`}
    avatarText={content.avatarText || 'Teslak'}
    emailIntro={`${content.emailIntro || ''} <span class="font-mono">Teslak<span class="i-carbon-at" aria-hidden="true"></span>proton.me</span>`}
  >
    <Content />
  </HomeIntro>
</Default>
